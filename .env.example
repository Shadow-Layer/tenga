# Tenga Inventory POS - Environment Configuration
# Copy this file to .env and update values for your deployment

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Environment mode: dev, test, prod
ENVIRONMENT=prod
# Enable debug logging (set to false in production)
DEBUG=false

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection parameters
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tenga
POSTGRES_USER=tenga_user
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
# Database pool settings for production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
# Enable SQL query logging (verbose, not recommended for production)
SQL_ECHO=false

# ============================================================================
# API CONFIGURATION
# ============================================================================
# API server settings
API_TITLE=Tenga Inventory POS
API_VERSION=T013
API_PORT=8000
# CORS settings - configure for your frontend domain
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:80
CORS_ALLOW_CREDENTIALS=false

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Frontend server port
FRONTEND_PORT=80
# Frontend base URL (used for asset caching)
FRONTEND_BASE_URL=/

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - MUST be changed in production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32
# JWT token expiry settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format
LOG_FORMAT=json

# ============================================================================
# PERSISTENCE & BACKUP
# ============================================================================
# Data directory for persistent storage
DATA_DIR=/data
# Backup retention (days)
BACKUP_RETENTION_DAYS=30
# Daily backup time (24-hour format HH:MM, UTC)
BACKUP_TIME=02:00

# ============================================================================
# CLIENT/ORGANIZATION CONFIGURATION
# ============================================================================
# Organization/Client identifier for multi-tenant isolation
ORGANIZATION_ID=default
# Organization name
ORGANIZATION_NAME=Default Organization
