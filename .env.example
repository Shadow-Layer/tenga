# Application Environment
# dev, test, or prod
ENVIRONMENT=dev

# Database Configuration
# For development use SQLite
# For production use PostgreSQL: postgresql://user:password@host:5432/tenga
DATABASE_URL=sqlite:///./data/tenga.db

# Debug mode (set to false in production)
DEBUG=false

# API Configuration
API_TITLE=Tenga Inventory POS
API_VERSION=T008

# Database query logging (verbose)
SQL_ECHO=false

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
