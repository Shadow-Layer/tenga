# Stage 1: Build frontend
FROM node:22-slim as builder

WORKDIR /build

# Copy package files
COPY package.json ./

# Install dependencies (including dev dependencies for TypeScript)
RUN npm install

# Copy source code
COPY tsconfig.json vite.config.ts tailwind.config.js postcss.config.js index.html ./
COPY src/ src/

# Build frontend
RUN npm run build

# Stage 2: Nginx runtime
FROM nginx:alpine

# Non-root user for security
RUN addgroup -g 1000 appuser && adduser -D -u 1000 -G appuser appuser

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx-default.conf /etc/nginx/conf.d/default.conf

# Copy built application
COPY --from=builder --chown=appuser:appuser /build/dist /usr/share/nginx/html

# Create logs directory
RUN mkdir -p /var/log/nginx && chown -R appuser:appuser /var/log/nginx /var/cache/nginx /var/run

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
